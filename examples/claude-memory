#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="${1:-$(pwd)}"
VAULT_ROOT="${MEMORY_ORCHESTRATOR_ROOT:-}"

if [[ -n "$VAULT_ROOT" ]]; then
  memory-orchestrator init --vault "$VAULT_ROOT" >/dev/null
fi

if ! memory-orchestrator status >/dev/null 2>&1; then
  echo "Run memory-orchestrator init --vault /path/to/vault first." >&2
  exit 2
fi

exec memory-orchestrator agent claude "$PROJECT_DIR"
