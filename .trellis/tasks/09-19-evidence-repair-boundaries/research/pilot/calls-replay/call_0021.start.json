        "content": "{\"path\":\"payloads/answer_template.json\",\"status\":\"ok\",\"text\":\"{\\n  \\\"description\\\": \\\"Required JSON output for the TRAIN_TRANSFER_B mixed-warehouse allocation task.\\\",\\n  \\\"top_level_required_keys\\\": [\\n    \\\"wave_id\\\",\\n    \\\"line_actions\\\",\\n    \\\"transfer_requests\\\",\\n    \\\"blocked_orders\\\",\\n    \\\"order_rollup\\\",\\n    \\\"summary\\\"\\n  ],\\n  \\\"field_rules\\\": {\\n    \\\"wave_id\\\": {\\n      \\\"type\\\": \\\"string\\\",\\n      \\\"required_value\\\": \\\"TRAIN_TRANSFER_B\\\"\\n    },\\n    \\\"line_actions\\\": {\\n      \\\"type\\\": \\\"list\\\",\\n      \\\"ordering\\\": \\\"sort by order_id ascending, then line_id ascending\\\",\\n      \\\"item_required_keys\\\": [\\n        \\\"order_id\\\",\\n        \\\"line_id\\\",\\n        \\\"sku\\\",\\n        \\\"requested_warehouse\\\",\\n        \\\"requested_effective_available\\\",\\n        \\\"action\\\",\\n        \\\"ship_quantity\\\",\\n        \\\"transfer_from\\\",\\n        \\\"transfer_quantity\\\",\\n        \\\"backorder_quantity\\\",\\n        \\\"primary_reason\\\"\\n      ],\\n      \\\"item_fields\\\": {\\n        \\\"order_id\\\": \\\"string\\\",\\n        \\\"line_id\\\": \\\"integer\\\",\\n        \\\"sku\\\": \\\"string\\\",\\n        \\\"requested_warehouse\\\": {\\n          \\\"type\\\": \\\"enum\\\",\\n          \\\"allowed\\\": [\\n            \\\"WH_NORTH\\\",\\n            \\\"WH_CENTRAL\\\",\\n            \\\"WH_WEST\\\"\\n          ]\\n        },\\n        \\\"requested_effective_available\\\": {\\n          \\\"type\\\": \\\"integer\\\",\\n          \\\"units\\\": \\\"units\\\"\\n        },\\n        \\\"action\\\": {\\n          \\\"type\\\": \\\"enum\\\",\\n          \\\"allowed\\\": [\\n            \\\"ship\\\",\\n            \\\"transfer\\\",\\n            \\\"backorder\\\",\\n            \\\"manual_review\\\"\\n          ]\\n        },\\n        \\\"ship_quantity\\\": {\\n          \\\"type\\\": \\\"integer\\\",\\n          \\\"units\\\": \\\"units\\\"\\n        },\\n        \\\"transfer_from\\\": {\\n          \\\"type\\\": \\\"enum_or_null\\\",\\n          \\\"allowed\\\": [\\n            \\\"WH_NORTH\\\",\\n            \\\"WH_CENTRAL\\\",\\n            \\\"WH_WEST\\\",\\n            null\\n          ]\\n        },\\n        \\\"transfer_quantity\\\": {\\n          \\\"type\\\": \\\"integer\\\",\\n          \\\"units\\\": \\\"units\\\"\\n        },\\n        \\\"backorder_quantity\\\": {\\n          \\\"type\\\": \\\"integer\\\",\\n          \\\"units\\\": \\\"units\\\"\\n        },\\n        \\\"primary_reason\\\": {\\n          \\\"type\\\": \\\"enum\\\",\\n          \\\"allowed\\\": [\\n            \\\"none\\\",\\n            \\\"account_blocked\\\",\\n            \\\"account_review_required\\\",\\n            \\\"fraud_watch\\\",\\n            \\\"inactive_product\\\",\\n            \\\"insufficient_effective_stock\\\"\\n          ]\\n        }\\n      }\\n    },\\n    \\\"transfer_requests\\\": {\\n      \\\"type\\\": \\\"list\\\",\\n      \\\"ordering\\\": \\\"sort by order_id ascending, then line_id ascending\\\",\\n      \\\"item_required_keys\\\": [\\n        \\\"order_id\\\",\\n        \\\"line_id\\\",\\n        \\\"sku\\\",\\n        \\\"from_warehouse\\\",\\n        \\\"to_warehouse\\\",\\n        \\\"quantity\\\"\\n      ]\\n    },\\n    \\\"blocked_orders\\\": {\\n      \\\"type\\\": \\\"list\\\",\\n      \\\"item_type\\\": \\\"string\\\",\\n      \\\"ordering\\\": \\\"sort ascending\\\",\\n      \\\"meaning\\\": \\\"Orders stopped at account or customer-risk level, not line-only product reviews.\\\"\\n    },\\n    \\\"order_rollup\\\": {\\n      \\\"type\\\": \\\"list\\\",\\n      \\\"ordering\\\": \\\"sort by order_id ascending\\\",\\n      \\\"item_required_keys\\\": [\\n        \\\"order_id\\\",\\n        \\\"outcome\\\"\\n      ],\\n      \\\"outcome_allowed\\\": [\\n        \\\"ready_to_ship\\\",\\n        \\\"needs_transfer\\\",\\n        \\\"has_backorder\\\",\\n        \\\"manual_review\\\",\\n        \\\"mixed_actions\\\"\\n      ]\\n    },\\n    \\\"summary\\\": {\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"required_integer_keys\\\": [\\n        \\\"total_orders\\\",\\n        \\\"total_lines\\\",\\n        \\\"ship_lines\\\",\\n        \\\"transfer_lines\\\",\\n        \\\"backorder_lines\\\",\\n        \\\"manual_review_lines\\\",\\n        \\\"blocked_orders\\\",\\n        \\\"transfer_units\\\",\\n        \\\"backorder_units\\\"\\n      ]\\n    }\\n  }\\n}\\n\"}"
