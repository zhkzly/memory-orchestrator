    "properties": {
      "relation_id": {
        "type": "string",
        "minLength": 1
      },
      "project_id": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "const": "measured_effect"
      },
      "from": {
        "type": "string",
        "minLength": 1
      },
      "to": {
        "type": "string",
        "minLength": 1
      },
      "metric": {
        "const": "conditional_marginal_gain"
      },
      "value": {
        "type": "number"
      },
      "skill_revisions": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      },
      "dependency_revisions": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      },
      "background_skill_refs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "skill_id": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "skill_id",
            "revision"
          ],
          "additionalProperties": false
        }
      },
      "applicable_context": {
        "type": "object",
        "properties": {
          "task_family": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "task_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "case_set_hash": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "task_family",
          "task_ids",
          "case_set_hash"
        ],
        "additionalProperties": false
      },
      "source_snapshot_digest": {
        "type": "string",
        "minLength": 1
      },
      "contrast_plan_ref": {
        "type": "string",
        "minLength": 1
      },
      "supporting_refs": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "known_task_count": {
        "type": "integer",
        "minimum": 1
      },
      "repeats": {
        "type": "integer",
        "minimum": 1
      },
      "evidence_level": {
        "const": "executed_local_contrast"
      }
    },
    "required": [
      "relation_id",
      "project_id",
      "kind",
      "from",
      "to",
      "metric",
      "value",
      "skill_revisions",
      "dependency_revisions",
      "background_skill_refs",
      "applicable_context",
      "source_snapshot_digest",
      "contrast_plan_ref",
      "supporting_refs",
      "known_task_count",
      "repeats",
      "evidence_level"
    ],
    "additionalProperties": false,
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  }
}
