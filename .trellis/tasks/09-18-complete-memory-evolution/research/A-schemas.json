{
  "schemas": [
    {
      "id": "BaselineRecord",
      "title": "BaselineRecord",
      "json_schema": {
        "type": "object",
        "properties": {
          "baseline_id": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "empty",
              "seed"
            ]
          },
          "snapshot_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "seed_content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source": {},
          "created_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "baseline_id",
          "project_id",
          "kind",
          "snapshot_digest",
          "seed_content_hash",
          "source",
          "created_at"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "FeedbackPlan",
      "title": "FeedbackPlan",
      "json_schema": {
        "type": "object",
        "properties": {
          "feedback_plan_id": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "episode",
                  "evaluation_request"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "authority_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "execution_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "kind",
              "ref",
              "authority_ref",
              "execution_ref"
            ],
            "additionalProperties": false
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "task_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "evaluated_state_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "protocol_id": {
            "type": "string",
            "minLength": 1
          },
          "protocol_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "criterion_id": {
                  "type": "string",
                  "minLength": 1
                },
                "rule": {},
                "weight": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "criterion_id",
                "rule"
              ],
              "additionalProperties": false
            }
          },
          "aggregation": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "single_task_outcome",
                  "binary_all",
                  "weighted_sum"
                ]
              },
              "threshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          "scoring_policy": {
            "enum": [
              "completed_only",
              "available_artifact"
            ]
          },
          "visibility": {
            "enum": [
              "adaptation",
              "selection_only",
              "final_only"
            ]
          },
          "evaluator": {
            "type": [
              "object",
              "null"
            ]
          },
          "proxy": {
            "type": [
              "object",
              "null"
            ]
          },
          "requests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "request_id": {
                  "type": "string",
                  "minLength": 1
                },
                "criterion_id": {
                  "type": "string",
                  "minLength": 1
                },
                "feedback_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "request_id",
                "criterion_id",
                "feedback_id"
              ],
              "additionalProperties": false
            }
          },
          "assessment_id": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "minLength": 1
          },
          "request": {
            "type": "object"
          },
          "batch_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "enum": [
              "learning",
              "validation",
              "final"
            ]
          }
        },
        "required": [
          "feedback_plan_id",
          "project_id",
          "subject",
          "run_id",
          "task_revision",
          "evaluated_state_digest",
          "protocol_id",
          "protocol_hash",
          "criteria",
          "aggregation",
          "scoring_policy",
          "visibility",
          "evaluator",
          "proxy",
          "requests",
          "assessment_id",
          "created_at",
          "request",
          "batch_id",
          "purpose"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "CallbackAttempt",
      "title": "CallbackAttempt",
      "json_schema": {
        "type": "object",
        "properties": {
          "attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": "string",
            "minLength": 1
          },
          "batch_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "stage": {
            "enum": [
              "execute",
              "evaluate",
              "proxy"
            ]
          },
          "request_ref": {
            "type": "string",
            "minLength": 1
          },
          "started_at": {
            "type": "string",
            "minLength": 1
          },
          "config_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "recovery_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "attempt_id",
          "project_id",
          "batch_id",
          "run_id",
          "stage",
          "request_ref",
          "started_at",
          "config_hash",
          "recovery_ref"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "CallbackReturn",
      "title": "CallbackReturn",
      "json_schema": {
        "type": "object",
        "properties": {
          "attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": "string",
            "minLength": 1
          },
          "request_ref": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "execute",
              "evaluate",
              "proxy"
            ]
          },
          "returned_at": {
            "type": "string",
            "minLength": 1
          },
          "raw_output": {},
          "error": {
            "type": [
              "object",
              "null"
            ]
          },
          "measured_usage": {},
          "elapsed_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "attempt_id",
          "project_id",
          "request_ref",
          "stage",
          "returned_at",
          "raw_output",
          "error",
          "measured_usage",
          "elapsed_seconds"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "RecoveryResolution",
      "title": "RecoveryResolution",
      "json_schema": {
        "type": "object",
        "properties": {
          "resolution_id": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": "string",
            "minLength": 1
          },
          "request_ref": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "attach_result",
              "confirmed_not_executed",
              "close_unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {}
          },
          "source": {},
          "raw_output": {},
          "error": {
            "type": [
              "object",
              "null"
            ]
          },
          "measured_usage": {},
          "elapsed_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "resolution_id",
          "project_id",
          "request_ref",
          "action",
          "evidence",
          "source",
          "created_at"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "SamplingSegment",
      "title": "SamplingSegment",
      "json_schema": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": "string",
            "minLength": 1
          },
          "batch_id": {
            "type": "string",
            "minLength": 1
          },
          "started_at": {
            "type": "string",
            "minLength": 1
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "elapsed_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "status": {
            "enum": [
              "started",
              "completed",
              "blocked",
              "error"
            ]
          },
          "started_attempt_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "completed_attempt_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "record_id",
          "segment_id",
          "project_id",
          "batch_id",
          "started_at",
          "finished_at",
          "elapsed_seconds",
          "status",
          "started_attempt_ids",
          "completed_attempt_ids"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "SamplingBatchReceipt",
      "title": "SamplingBatchReceipt",
      "json_schema": {
        "type": "object",
        "properties": {
          "receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "project_id": {
            "type": "string",
            "minLength": 1
          },
          "batch_id": {
            "type": "string",
            "minLength": 1
          },
          "group_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "receipt_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "segment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "first_started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished_at": {
            "type": "string",
            "minLength": 1
          },
          "end_to_end_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "known_segment_seconds": {
            "type": "number",
            "minimum": 0
          },
          "missing_segment_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "receipt_id",
          "project_id",
          "batch_id",
          "group_ids",
          "receipt_refs",
          "segment_ids",
          "first_started_at",
          "finished_at",
          "end_to_end_seconds",
          "known_segment_seconds",
          "missing_segment_count"
        ],
        "additionalProperties": false
      }
    }
  ],
  "optional_properties": {
    "Feedback": {
      "feedback_plan_ref": {
        "type": "string",
        "minLength": 1
      },
      "request_ref": {
        "type": "string",
        "minLength": 1
      },
      "attempt_ref": {
        "type": [
          "string",
          "null"
        ]
      },
      "execution_ref": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "TaskAssessment": {
      "feedback_plan_ref": {
        "type": "string",
        "minLength": 1
      },
      "expected_criterion_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "missing_criterion_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "criterion_coverage": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "score_bounds": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "feedback_sources": {
        "type": "array",
        "items": {
          "enum": [
            "external",
            "human",
            "llm_proxy"
          ]
        },
        "uniqueItems": true
      },
      "execution_ref": {
        "type": [
          "string",
          "null"
        ]
      },
      "supersedes": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "SamplingBatchPlan": {
      "recovery_version": {
        "const": 1
      },
      "created_at": {
        "type": "string",
        "minLength": 1
      }
    },
    "RunGroupPlan": {
      "recovery_version": {
        "const": 1
      },
      "input_ref": {
        "type": "string",
        "minLength": 1
      }
    },
    "RunGroupPlan_slot": {
      "episode_id": {
        "type": "string",
        "minLength": 1
      },
      "feedback_plan_id": {
        "type": "string",
        "minLength": 1
      },
      "assessment_id": {
        "type": "string",
        "minLength": 1
      }
    },
    "RunBundle": {
      "chosen_attempt_ref": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
