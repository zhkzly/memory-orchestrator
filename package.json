{
  "name": "memory-orchestrator",
  "version": "0.1.0",
  "description": "CLI-first local memory orchestration for agent workflows.",
  "type": "module",
  "bin": {
    "memory-orchestrator": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema.json",
    "tools.md",
    "skills",
    "templates",
    "examples",
    "scripts",
    "evaluation",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "mcp": "tsx src/mcp.ts",
    "harness": "node scripts/harness.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
