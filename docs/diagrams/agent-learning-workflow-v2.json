{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "原生 Agent 的经验改进流程（拟议）",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "execution",
      "label": "当前任务 · 原生 Agent"
    },
    {
      "id": "learning",
      "label": "后台学习 · 反馈驱动"
    },
    {
      "id": "outcomes",
      "label": "保留证据 · 独立评价"
    }
  ],
  "mainPath": [
    "request",
    "retrieve",
    "native_run",
    "episode",
    "delivery"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "request"
    ],
    "allowedTerminals": [
      "delivery",
      "deferred",
      "rejected",
      "report"
    ],
    "requiredEdges": [
      {
        "from": "promotion",
        "to": "retrieve"
      },
      {
        "from": "episode",
        "to": "feedback"
      },
      {
        "from": "comparison",
        "to": "rejected"
      }
    ],
    "requiredPaths": [
      {
        "from": "request",
        "to": "delivery"
      },
      {
        "from": "feedback",
        "to": "promotion"
      }
    ]
  },
  "nodes": [
    {
      "id": "request",
      "lane": "execution",
      "col": 0,
      "type": "frontend",
      "label": "任务与初态",
      "sublabel": "目标 · 约束 · 仓库版本"
    },
    {
      "id": "retrieve",
      "lane": "execution",
      "col": 1,
      "type": "database",
      "label": "加载适用经验",
      "sublabel": "已发布版本；按需注入"
    },
    {
      "id": "native_run",
      "lane": "execution",
      "col": 2,
      "type": "backend",
      "label": "原生 Agent 执行",
      "sublabel": "Codex / Claude Code",
      "width": 124
    },
    {
      "id": "episode",
      "lane": "execution",
      "col": 3,
      "type": "database",
      "label": "归档执行证据",
      "sublabel": "工具事件 · 产物 · 版本"
    },
    {
      "id": "delivery",
      "lane": "execution",
      "col": 4,
      "type": "external",
      "label": "交付当前结果",
      "sublabel": "不等待后台学习"
    },
    {
      "id": "feedback",
      "lane": "learning",
      "col": 0,
      "type": "backend",
      "label": "取得并组织反馈",
      "sublabel": "测试 · 人工 · 模型判断"
    },
    {
      "id": "diagnosis",
      "lane": "learning",
      "col": 1,
      "type": "backend",
      "label": "轨迹定位与归因",
      "sublabel": "任务 + 事件 + 当前资产"
    },
    {
      "id": "eligibility",
      "lane": "learning",
      "col": 2,
      "type": "security",
      "label": "证据足以提案？",
      "sublabel": "适用范围 · 替代解释"
    },
    {
      "id": "candidate",
      "lane": "learning",
      "col": 3,
      "type": "backend",
      "label": "生成候选修改",
      "sublabel": "经验 / Skill / 必要脚本"
    },
    {
      "id": "comparison",
      "lane": "learning",
      "col": 4,
      "type": "security",
      "label": "对照执行与验收",
      "sublabel": "旧版 vs 新版 · 回归 · 成本",
      "width": 118
    },
    {
      "id": "promotion",
      "lane": "learning",
      "col": 5,
      "type": "database",
      "label": "发布新版本",
      "sublabel": "保留来源与旧版"
    },
    {
      "id": "deferred",
      "lane": "outcomes",
      "col": 2,
      "type": "database",
      "label": "暂存并补证",
      "sublabel": "未知或无可复用改进"
    },
    {
      "id": "rejected",
      "lane": "outcomes",
      "col": 4,
      "type": "database",
      "label": "不发布候选",
      "sublabel": "保持现有版本"
    },
    {
      "id": "report",
      "lane": "outcomes",
      "col": 5,
      "type": "external",
      "label": "未见任务评测",
      "sublabel": "冻结协议 · 只产出报告"
    }
  ],
  "edges": [
    {
      "from": "request",
      "to": "retrieve",
      "role": "main"
    },
    {
      "from": "retrieve",
      "to": "native_run",
      "role": "main"
    },
    {
      "from": "native_run",
      "to": "episode",
      "role": "main"
    },
    {
      "from": "episode",
      "to": "delivery",
      "role": "branch"
    },
    {
      "from": "episode",
      "to": "feedback",
      "label": "后台分析",
      "role": "async",
      "variant": "dashed"
    },
    {
      "from": "feedback",
      "to": "diagnosis",
      "role": "main"
    },
    {
      "from": "diagnosis",
      "to": "eligibility",
      "role": "main"
    },
    {
      "from": "eligibility",
      "to": "candidate",
      "label": "可提案",
      "role": "main"
    },
    {
      "from": "eligibility",
      "to": "deferred",
      "label": "暂不修改",
      "role": "branch",
      "variant": "dashed"
    },
    {
      "from": "candidate",
      "to": "comparison",
      "role": "main"
    },
    {
      "from": "comparison",
      "to": "promotion",
      "label": "验收通过",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "from": "comparison",
      "to": "rejected",
      "label": "失败或证据不足",
      "role": "error",
      "variant": "security"
    },
    {
      "from": "promotion",
      "to": "retrieve",
      "label": "后续任务使用",
      "role": "return",
      "variant": "emphasis",
      "toSide": "top"
    },
    {
      "from": "promotion",
      "to": "report",
      "label": "冻结后评测",
      "role": "branch",
      "variant": "dashed"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "反馈必须有来源",
      "items": [
        "执行检查：测试、产物、环境状态，绑定被测版本。",
        "人工：实际 review 与修正；模型：明确标注为代理判断。"
      ]
    },
    {
      "dot": "violet",
      "title": "轨迹参与两次判断",
      "items": [
        "评价：是否满足任务要求；归因：哪些操作解释结果。",
        "保存原始证据与截断标记；区分事实、假设和未知。"
      ]
    },
    {
      "dot": "emerald",
      "title": "效果必须再次验证",
      "items": [
        "候选选择用开发任务与回归集；最终测试不回流修改。",
        "记录总成本与负收益；已发布版本出现退化可停用回退。"
      ]
    }
  ]
}

